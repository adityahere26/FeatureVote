# Public: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to false until Google credentials exist; true enables the local password form.
NEXT_PUBLIC_GOOGLE_AUTH=true
NEXT_PUBLIC_PASSWORD_AUTH=false

# Server only: never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
